{
  "compilerOptions": {
    "types": ["node", "jest"],
    "isolatedModules": true,
    "target": "esnext",
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}